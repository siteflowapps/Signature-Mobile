	<string>CDO needs your location to add GPS coordinates to photos for verification and compliance purposes.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>CDO needs access to your photo library to select and upload images for outlet onboarding and invoice processing.</string>
	<key>UIAppFonts</key>
	<array>
		<string>Inter-Regular.ttf</string>
		<string>Inter-Medium.ttf</string>
		<string>Inter-SemiBold.ttf</string>
		<string>Inter-Bold.ttf</string>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>FIREBASE_ENV</key>
	<string>$(FIREBASE_ENV)</string>
</dict>
</plist>
